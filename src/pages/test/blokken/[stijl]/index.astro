---
// Testpagina: de Energylandia-pagina in vier stijlen voor de tekstblokken (tip, gouden tip, mening, ter info, ...).
// Enkel om te vergelijken; staat niet in de sitemap en wordt niet geïndexeerd.
import Base from "../../../../layouts/Base.astro";
import PlacePage from "../../../../components/place/PlacePage.astro";
import { countryBySlug } from "../../../../lib/data.js";
import { places } from "../../../../lib/places.js";
import { u } from "../../../../lib/util.js";

const STIJLEN = [
  { id: "1", naam: "Links ook afgerond, met lijn" },
  { id: "2", naam: "Afgerond, zonder lijn" },
  { id: "3", naam: "Minder fel, afgerond, zonder lijn" },
  { id: "4", naam: "Minder fel, afgerond, met lijn" },
  { id: "5", naam: "Huidige stijl (zoals nu)" },
];

export function getStaticPaths() {
  return ["1", "2", "3", "4", "5"].map((stijl) => ({ params: { stijl } }));
}

const i = STIJLEN.findIndex((s) => s.id === Astro.params.stijl);
const stijl = STIJLEN[i];
const volgende = STIJLEN[(i + 1) % STIJLEN.length];
const c = countryBySlug("polen")!;
const park = places(c).find((x) => x.slug === "energylandia")!;
// Energylandia heeft zelf geen waarschuwing; voor de vergelijking lenen we die van de MSC-cruise (enkel op deze testpagina).
const cruise = places(countryBySlug("verenigde-staten")!).find((x) => x.slug === "cruisen-met-de-msc-seashore")!;
const a = { ...park, warn: cruise.warn };
---
<Base title={`Test blokken ${stijl.id}: ${stijl.naam}`} description="Testpagina" path={`test/blokken/${stijl.id}/`} noindex image={a.hero}>
  <article id="country" class={`blokstijl-${stijl.id}`}><PlacePage c={c} a={a} /></article>
  <div class="wrap blok-test-nav">
    <p><b>Stijl {stijl.id} van {STIJLEN.length}:</b> {stijl.naam}</p>
    <a href={u(`test/blokken/${volgende.id}/`)}>Volgende manier: {volgende.naam} →</a>
  </div>
</Base>

<style is:global>
  :is(.blokstijl-1, .blokstijl-2, .blokstijl-3, .blokstijl-4) :is(.mening-box, .gold-box, .tips, .gal-text.info, .warn-box, .story-box) { border-radius: 14px; }
  :is(.blokstijl-2, .blokstijl-3) :is(.mening-box, .gold-box, .tips, .gal-text.info, .warn-box, .story-box) { border-left: 0; }
  :is(.blokstijl-3, .blokstijl-4) :is(.mening-box, .gold-box, .tips, .gal-text.info, .warn-box, .story-box) { filter: saturate(.6) brightness(1.025); }
  .blok-test-nav { margin: 48px auto 64px; padding: 20px 24px; border: 2px dashed #0f766e; border-radius: 14px; display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; justify-content: space-between; }
  .blok-test-nav p { margin: 0; }
  .blok-test-nav a { font-weight: 700; color: #0f766e; }
</style>

---
import Base from "../../../../layouts/Base.astro";
import { countries, countryBySlug } from "../../../../lib/data.js";
import PlacePage from "../../../../components/place/PlacePage.astro";
import { places } from "../../../../lib/places.js";
import { excerpt } from "../../../../lib/util.js";
import { SITE_NAME } from "../../../../config.js";

export function getStaticPaths() {
  return countries.flatMap((c) => places(c).map((a) => ({ params: { land: c.slug, plaats: a.slug } })));
}

const c = countryBySlug(Astro.params.land)!;
const a = places(c).find((x) => x.slug === Astro.params.plaats)!;
const description = excerpt(a.text || c.tagline || c.intro || "", 155);
---
<Base title={`${a.t} · ${c.name} · ${SITE_NAME}`} description={description} path={`bestemmingen/${c.slug}/${a.slug}/`} hasHero={!!(c.done && a.hero)} strava={!!a.stravaEmbed} image={a.hero || a.photos[0]}>
  <article id="country"><PlacePage c={c} a={a} /></article>
</Base>
